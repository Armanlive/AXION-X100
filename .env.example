[TEMPLATE]
# AXION-X100 Prototype Environment Configuration
# NOTICE: Client-side prototype configuration only. Do not place production secrets here.
# Production credential storage is planned for future OS-level native keychain integration.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.

# Optional client key for browser prototype Gemini assistance
VITE_GEMINI_API_KEY=

# ===== Supabase Cloud Sync (hybrid memory: profiles + milestone summaries) =====
# Public client values — safe to expose in the browser bundle (anon/publishable key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only: keep unprefixed so Vite never bundles it into frontend code.
# Used by future Rust/Tauri sidecar or Supabase Edge Functions — never the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ===== OmniRoute / RuFlo Local Gateway =====
# Zero-cost local AI router (AXION-X100 + RuFlo + OpenRouter Free pipeline)
# Base URL: http://localhost:2828/v1
# Model: openrouter/openrouter/free

# API Key from OMNIROUTE_API_KEY environment variable (local env)
# Leave empty to load from system environment at runtime
OMNIROUTE_BASE_URL=http://localhost:2828/v1
OMNIROUTE_API_KEY=$env:OMNIROUTE_API_KEY
OMNIROUTE_MODEL=openrouter/openrouter/free
OMNIROUTE_EXPERIMENTAL=true

# Stale file scan threshold (30 days = default scan staleness window)
STALE_SCAN_THRESHOLD_DAYS=30
